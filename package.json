{
  "name": "collab-studio",
  "version": "1.0.0",
  "description": "Real-time collaborative creative studio — Scripts, Mind Maps & Stories over LAN. Zero setup, no cloud.",
  "keywords": [
    "collaboration",
    "mindmap",
    "screenplay",
    "story",
    "LAN",
    "real-time",
    "creative-writing"
  ],
  "homepage": "https://github.com/foweh/collab-studio",
  "license": "MIT",
  "author": "CollabStudio",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node server.js --port 3001 --join localhost:3000",
    "build": "npx pkg . --targets node20-win-x64 --output dist/CollabStudio/CollabStudio.exe",
    "build:zip": "powershell Compress-Archive -Path dist/CollabStudio/* -DestinationPath dist/CollabStudio.zip -Force"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.18.2",
    "helmet": "^8.2.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.2",
    "marked": "^18.0.11",
    "multer": "^2.3.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.8.3",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "studio-vue/**/*",
      "fenjing-local/**/*",
      ".admin.env"
    ],
    "targets": [
      "node20-win-x64"
    ]
  }
}
