# Collab Studio 环境变量配置

# 管理员密码（必填！如不设置首次启动会生成随机密码并打印在控制台）
# ADMIN_PASSWORD=your_secure_password_here

# 服务端口（默认 3000）
# PORT=3000

# UDP 广播发现端口（默认 41234，多实例共存时修改）
# UDP_PORT=41235

# 场景检测 Flask 子进程端口（默认 5000，多实例共存时修改）
# SCENEDETECT_PORT=5001

# HTTPS 端口（默认 443，有 ssl/ 证书时启用；与同机其他服务冲突时修改）
# HTTPS_PORT=8443
